<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/cardview_gruenhell"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/quoteTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="Zitat Text"
            android:ellipsize="end"
            android:fontFamily="@font/robotozitate"
            android:maxLines="3"
            android:text="Zitat"
            android:textColor="@color/text_schwarz"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/saveQuoteButton"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/quoteAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="Autor des Zitats"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="- Unbekannter Autor"
            android:textColor="@color/text_schwarz"
            android:textSize="17sp"
            android:fontFamily="@font/robotoregular"
            app:layout_constraintEnd_toStartOf="@+id/saveQuoteButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quoteTextView"
            app:layout_constraintWidth_percent="0.8" />

        <ImageButton
            android:id="@+id/saveQuoteButton"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Zitat speichern oder zu Favoriten hinzufügen"
            android:padding="8dp"
            android:src="@drawable/bookmark_heart_neu40px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/error_red" />

        <TextView
            android:id="@+id/tagTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:text="TAG"
            android:textSize="15sp"
            android:fontFamily="@font/robotoregular"
            android:textColor="@color/text_schwarz"
            app:layout_constraintEnd_toStartOf="@+id/saveQuoteButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quoteAuthor"
            app:layout_constraintWidth_percent="0.8" />

        <TextView
            android:id="@+id/keywordsTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp"
            android:fontFamily="@font/robotoregular"
            android:text="Keywords"
            android:textColor="@color/text_schwarz"
            app:layout_constraintEnd_toStartOf="@+id/saveQuoteButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tagTextView"
            app:layout_constraintWidth_percent="0.8" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>