<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home (Startscreen) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.projektworldwisdom.home.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_authorDetailsFragment"
            app:destination="@id/authorDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_quoteDetailsFragment"
            app:destination="@id/quoteDetailsFragment" />
    </fragment>

    <!-- Collection-Screen für die gespeicherten Zitate -->
    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.projektworldwisdom.collection.CollectionFragment"
        android:label="CollectionFragment" >
        <action
            android:id="@+id/action_collectionFragment_to_quoteDetailsFragment"
            app:destination="@id/quoteDetailsFragment" />
    </fragment>

    <!-- Profil-Screen -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.projektworldwisdom.profile.ProfileFragment"
        android:label="ProfileFragment" >
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Settings (MVP) -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.projektworldwisdom.settings.SettingsFragment"
        android:label="SettingsFragment" />

    <!-- Login / Register wie gehabt -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.projektworldwisdom.login.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.projektworldwisdom.register.RegisterFragment"
        android:label="RegisterFragment" >
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <!-- Quote Details -->
    <fragment
        android:id="@+id/quoteDetailsFragment"
        android:name="com.example.projektworldwisdom.quote.QuoteDetailsFragment"
        android:label="QuoteDetailsFragment" >

        <!-- Required: to identify the quote uniquely -->
        <argument
            android:name="quoteId"
            app:argType="string"
            app:nullable="false" />

        <!-- Optional: pass everything needed so the screen can render without refetch -->
        <argument
            android:name="author"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="quoteText"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="category"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tags"
            app:argType="string[]"
            app:nullable="true" />
        <argument
            android:name="sourceUrl"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isFavorite"
            app:argType="boolean"
            app:nullable="false"
            android:defaultValue="false" />

        <action
            android:id="@+id/action_quoteDetailsFragment_to_authorDetailsFragment"
            app:destination="@id/authorDetailsFragment" />
    </fragment>

    <!-- Author Details -->
    <fragment
        android:id="@+id/authorDetailsFragment"
        android:name="com.example.projektworldwisdom.AuthorDetail.AuthorDetailsFragment"
        android:label="AuthorDetailsFragment" >
        <argument
            android:name="authorSlug"
            app:argType="string"
            app:nullable="false" />
        <!-- Optional: pass real detail data when navigating (no extra fetch needed) -->
        <argument
            android:name="authorName"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorDescription"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorBio"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorSourceUrl"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>