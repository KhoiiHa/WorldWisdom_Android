<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <!-- Keine ViewModel-Variablen mehr nötig:
             Fragment setzt die Texte per Code über ViewBinding -->
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_author_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="56dp"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/author_details_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="88dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/toolbar_author_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:context=".AuthorDetail.AuthorDetailsFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardUseCompatPadding="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:rippleColor="?attr/colorControlHighlight">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/author_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/WW.Text.Title"
                            tools:text="Marcus Aurelius" />

                        <TextView
                            android:id="@+id/author_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            style="@style/WW.Text.Meta"
                            tools:text="Römischer Kaiser und stoischer Philosoph, bekannt für seine Meditationen."
                            tools:targetApi="28" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:rippleColor="?attr/colorControlHighlight">

                    <TextView
                        android:id="@+id/author_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        style="@style/WW.Text.Body"
                        tools:text="Kurzbiografie, Hintergrund und relevante Lebensstationen der Autorin oder des Autors."
                        tools:targetApi="28" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAuthorQuotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/author_details_show_quotes"
                    android:hapticFeedbackEnabled="true"
                    style="@style/WW.Button.Secondary" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/author_link_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:hapticFeedbackEnabled="true"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:rippleColor="?attr/colorControlHighlight">

                    <TextView
                        android:id="@+id/author_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        style="@style/WW.Text.Meta"
                        android:autoLink="web"
                        android:linksClickable="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColorLink="?attr/colorPrimary"
                        tools:text="https://de.wikipedia.org/wiki/Marcus_Aurelius" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>