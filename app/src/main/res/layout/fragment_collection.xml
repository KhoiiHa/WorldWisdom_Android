<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:paddingBottom="0dp"
    tools:context=".collection.CollectionFragment">

    <!-- Titel -->
    <TextView
        android:id="@+id/tvCollectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/collection_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvCollectionCount"
        style="@style/WW.Text.Title" />

    <!-- Optional Count (set from Fragment/ViewModel) -->
    <TextView
        android:id="@+id/tvCollectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginEnd="24dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvCollectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="3 Favoriten"
        style="@style/WW.Text.Meta" />

    <!-- Untertitel -->
    <TextView
        android:id="@+id/tvCollectionSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/collection_subtitle"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvCollectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/WW.Text.Body" />

    <!-- Content container: Explore by Category + RecyclerView + States (Empty / Loading / Error) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/collectionContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCollectionSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Explore by Category (minimal, kann später in eigenen Screen ausgelagert werden) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExploreCategories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="?attr/colorSurface"
            app:rippleColor="?attr/colorControlHighlight"
            android:hapticFeedbackEnabled="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvExploreTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/collection_explore_title"
                        style="@style/WW.Text.Title" />

                    <TextView
                        android:id="@+id/btnCategoryOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/collection_category_overview"
                        style="@style/WW.Text.Meta"
                        android:textColor="?attr/colorPrimary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:hapticFeedbackEnabled="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvExploreSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/collection_explore_subtitle"
                    style="@style/WW.Text.Meta" />

                <HorizontalScrollView
                    android:id="@+id/scrollCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <!-- Chips werden im Fragment dynamisch befüllt -->

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Content: Favoriten-Liste -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCollection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:layout_marginTop="12dp"
            android:paddingTop="0dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/cardExploreCategories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_quote" />

        <!-- Empty State (default: GONE) -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardExploreCategories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEmptyIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@null"
                android:alpha="0.9"
                android:src="@drawable/ic_star_outline"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/collection_empty_title"
                style="@style/WW.Text.Title" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/collection_empty_subtitle"
                style="@style/WW.Text.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyCta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/collection_empty_cta"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:iconPadding="8dp"
                style="@style/WW.Button.Secondary"
                android:hapticFeedbackEnabled="true" />

        </LinearLayout>

        <!-- Loading State (default: GONE) -->
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            android:indeterminateTint="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/cardExploreCategories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone" />

        <!-- Error State (default: GONE) -->
        <LinearLayout
            android:id="@+id/layoutErrorState"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardExploreCategories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_error_title"
                style="@style/WW.Text.Title" />

            <TextView
                android:id="@+id/tvErrorSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/common_error_subtitle"
                style="@style/WW.Text.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/WW.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/common_retry"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                android:hapticFeedbackEnabled="true" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>