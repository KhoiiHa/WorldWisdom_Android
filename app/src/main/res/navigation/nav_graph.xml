<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home (Startscreen) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.projektworldwisdom.home.HomeFragment"
        android:label="@string/nav_home" >
        <action
            android:id="@+id/action_homeFragment_to_authorDetailsFragment"
            app:destination="@id/authorDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_quoteDetailsFragment"
            app:destination="@id/quoteDetailsFragment" />
        <argument
            android:name="initialCategory"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_homeFragment_to_categoryOverviewFragment"
            app:destination="@id/categoryOverviewFragment">
            <argument
                android:name="origin"
                app:argType="string"
                android:defaultValue="home" />
        </action>
    </fragment>

    <!-- Collection-Screen für die gespeicherten Zitate -->
    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.projektworldwisdom.collection.CollectionFragment"
        android:label="@string/nav_collection" >
        <argument
            android:name="initialCategory"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_collectionFragment_to_quoteDetailsFragment"
            app:destination="@id/quoteDetailsFragment" />
        <action
            android:id="@+id/action_collectionFragment_to_categoryOverviewFragment"
            app:destination="@id/categoryOverviewFragment">
            <argument
                android:name="origin"
                app:argType="string"
                android:defaultValue="collection" />
        </action>
    </fragment>

    <!-- Category Overview (Kategorien-Übersicht) -->
    <fragment
        android:id="@+id/categoryOverviewFragment"
        android:name="com.example.projektworldwisdom.category.CategoryOverviewFragment"
        android:label="@string/nav_categories" >

        <!-- Optional: hilft uns später, je nach Einstieg (Home vs. Collection) korrekt zurück zu navigieren -->
        <argument
            android:name="origin"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="home" />

        <!-- Rücksprung nach Home (z.B. wenn CategoryOverview von Home geöffnet wurde) -->
        <action
            android:id="@+id/action_categoryOverviewFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true" />

        <!-- Rücksprung zur Collection (z.B. wenn CategoryOverview von Collection geöffnet wurde) -->
        <action
            android:id="@+id/action_categoryOverviewFragment_to_collectionFragment"
            app:destination="@id/collectionFragment"
            app:launchSingleTop="true" />

        <!-- Kategorie -> Quote-Liste pro Kategorie -->
        <action
            android:id="@+id/action_categoryOverviewFragment_to_categoryQuotesFragment"
            app:destination="@id/categoryQuotesFragment" />

    </fragment>

    <!-- Category Quotes (Quote-Liste pro Kategorie) -->
    <fragment
        android:id="@+id/categoryQuotesFragment"
        android:name="com.example.projektworldwisdom.category.CategoryQuotesFragment"
        android:label="Category Quotes" >

        <!-- Kategorie, die angezeigt wird -->
        <argument
            android:name="category"
            app:argType="string"
            app:nullable="false" />

        <!-- Optional: woher wir kommen (Overview vs. Collection) -->
        <argument
            android:name="origin"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="overview" />

        <!-- Quote-Klick -> QuoteDetails -->
        <action
            android:id="@+id/action_categoryQuotesFragment_to_quoteDetailsFragment"
            app:destination="@id/quoteDetailsFragment" />

    </fragment>

    <!-- Profil-Screen -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.projektworldwisdom.profile.ProfileFragment"
        android:label="@string/nav_profile" >
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:launchSingleTop="true" />
    </fragment>

    <!-- Settings (MVP) -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.projektworldwisdom.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <!-- Login / Register wie gehabt -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.projektworldwisdom.login.LoginFragment"
        android:label="@string/nav_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.projektworldwisdom.register.RegisterFragment"
        android:label="@string/nav_register" >
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Quote Details -->
    <fragment
        android:id="@+id/quoteDetailsFragment"
        android:name="com.example.projektworldwisdom.quote.QuoteDetailsFragment"
        android:label="@string/nav_quote_details" >

        <!-- Required: to identify the quote uniquely -->
        <argument
            android:name="quoteId"
            app:argType="string"
            app:nullable="false" />

        <!-- Optional: pass everything needed so the screen can render without refetch -->
        <argument
            android:name="author"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="quoteText"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="category"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tags"
            app:argType="string[]"
            app:nullable="true" />
        <argument
            android:name="sourceUrl"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isFavorite"
            app:argType="boolean"
            app:nullable="false"
            android:defaultValue="false" />

        <action
            android:id="@+id/action_quoteDetailsFragment_to_authorDetailsFragment"
            app:destination="@id/authorDetailsFragment" />
    </fragment>

    <!-- Author Details -->
    <fragment
        android:id="@+id/authorDetailsFragment"
        android:name="com.example.projektworldwisdom.AuthorDetail.AuthorDetailsFragment"
        android:label="@string/nav_author_details" >
        <argument
            android:name="authorSlug"
            app:argType="string"
            app:nullable="false" />
        <!-- Optional: pass real detail data when navigating (no extra fetch needed) -->
        <argument
            android:name="authorName"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorDescription"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorBio"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorSourceUrl"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>